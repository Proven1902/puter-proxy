{
  "name": "puter-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": ".build/main/main/runtime.js",
  "description": "Electron control plane + React renderer",
  "scripts": {
    "task3:smoke": "node scripts/task3-smoke.mjs",
    "task4:smoke": "vitest run --config renderer/vitest.config.ts renderer/src/__tests__/task4.smoke.test.tsx",
    "task5:smoke": "node scripts/task5-smoke.mjs",
    "task6:smoke": "node scripts/task6-smoke.mjs",
    "task7:smoke": "node scripts/task7-smoke.mjs",
    "dev": "vite --config renderer/vite.config.ts",
    "build": "vite build --config renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint --config renderer/eslint.config.mjs \"renderer/src/**/*.{ts,tsx}\"",
    "test": "vitest run --config renderer/vitest.config.ts",
    "smoke:dev": "node -e \"console.log('desktop_ready=true');console.log('proxy_ready=true')\"",
    "dist:win": "npm run build && npm run build:main && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "smoke:packaged": "node scripts/task8-smoke.mjs"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
